# --- Database ---
DATABASE_URL="postgresql://courier:courier@localhost:5432/courier_dev?schema=public"

# --- Redis (job queue / dispatch locks) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# MVP placeholder: local JWT auth so the API runs standalone without a Firebase project.
# Swap this module for Firebase Admin SDK verification when you wire up real Firebase Auth
# (see apps/api/src/middleware/auth.ts for the exact seam to replace).
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# --- Stripe (payments) - NOT wired to a live account, sandbox keys only ---
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# --- App ---
PORT=4000
NODE_ENV=development
ADMIN_ORIGIN="http://localhost:3000"

# Offer timing / dispatch tuning
OFFER_TIMEOUT_SECONDS=45
QUOTE_EXPIRY_MINUTES=15
