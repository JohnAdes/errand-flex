# --- Database ---
DATABASE_URL="postgresql://courier:courier@localhost:5432/courier_dev?schema=public"

# --- Redis (job queue / dispatch locks) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# MVP default: local JWT auth so the API runs standalone without a Firebase project.
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"

# Set AUTH_PROVIDER=firebase to switch to real Firebase ID token verification
# (see apps/api/src/middleware/auth.ts). Requires a Firebase service account —
# FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY come from that JSON key file.
AUTH_PROVIDER="local"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Payments ---
# MVP default: MockPaymentProvider, no external account needed (this is what
# CI/tests run against). Set PAYMENT_PROVIDER=stripe to activate real Stripe —
# see apps/api/src/modules/payments/payment.provider.ts for the scope note on
# what that does (and doesn't yet) cover end-to-end.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# --- File storage (signed uploads for custody-verification photos) ---
# MVP default: mock signed URLs, nothing real uploaded anywhere. Set
# STORAGE_PROVIDER=firebase to issue real Firebase Cloud Storage signed
# upload URLs (POST /v1/uploads/signed-url) — reuses the FIREBASE_* auth vars
# above for credentials.
STORAGE_PROVIDER="mock"
FIREBASE_STORAGE_BUCKET=""

# --- SMS ---
# MVP default: logs instead of sending. Set SMS_PROVIDER=twilio to send real
# verification texts via POST /v1/auth/verify-phone/send.
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- App ---
PORT=4000
NODE_ENV=development
ADMIN_ORIGIN="http://localhost:3000"

# Offer timing / dispatch tuning
OFFER_TIMEOUT_SECONDS=45
QUOTE_EXPIRY_MINUTES=15
